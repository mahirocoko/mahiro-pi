{
  "name": "@mahirocoko/mahiro-pi",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "description": "Native Pi companion UI, maintained memory, guarded RTK, explicit workflow tools and parent-scoped Herdr metadata.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": ">=1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "40.2.2",
    "@gotgenes/pi-subagents": "23.4.1"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "bootstrap": "node bootstrap.mjs",
    "install:profile": "node install.mjs",
    "memory:maintenance": "node memory-maintenance.mjs",
    "goal:preview": "node goal-preview.mjs",
    "test": "node --import ./test/public-dependency-loader.mjs --test --test-concurrency=1 test/*.test.ts",
    "check:docs": "node check-docs.mjs",
    "check:continuity-format": "biome format lib/continuity extensions/mahiro-continuity.ts test/continuity*.ts",
    "check": "pnpm check:types && pnpm check:format && node check-package.mjs && node check-docs.mjs && node --import ./test/public-dependency-loader.mjs --test --test-concurrency=1 test/*.test.ts && node check-public-sdk.mjs",
    "check:types": "node check-types.mjs",
    "check:public-sdk": "node check-public-sdk.mjs",
    "check:geometry": "node check-geometry.ts",
    "format": "biome format --write .",
    "check:format": "biome format ."
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./lib/guards/bootstrap.ts",
      "./lib/guards/index.ts",
      "./extensions/mahiro-status.ts",
      "./extensions/mahiro-finish-voice.ts",
      "./extensions/mahiro-agent-memory.ts",
      "./extensions/mahiro-continuity.ts",
      "./extensions/mahiro-native-utilities.ts",
      "./extensions/mahiro-code-map.ts",
      "./extensions/mahiro-goal.ts",
      "./extensions/mahiro-code-evidence.ts",
      "./extensions/mahiro-ux-workflow.ts",
      "./extensions/mahiro-execution-run.ts",
      "./extensions/mahiro-claude-ui.ts"
    ],
    "themes": [
      "./themes/mahiro-claude-dark.json",
      "./themes/mahiro-obsidian-dark.json",
      "./themes/mahiro-ember-dark.json",
      "./themes/mahiro-nordic-dark.json"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "22.19.19",
    "esbuild": "0.28.1",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
