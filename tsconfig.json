{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts", "extensions/**/*.ts", "test/**/*.ts", "check-geometry.ts"],
  "exclude": ["node_modules", ".agent-state", "test/oracles"]
}
