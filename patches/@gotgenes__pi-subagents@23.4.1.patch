@@ -0,0 +1,80 @@
+import type { SubagentsService } from "./service";
+
+// Private metadata index, never a queue, policy resolver or session-id registry.
+// Pi loads extensions with moduleCache:false. Share the registry across loader
+// instances, while retaining the WeakMap in a private closure. This is metadata
+// isolation among trusted extensions, not an in-process authorization boundary.
+const key = Symbol.for("pi-subagents.session-owner-registry.v1");
+interface Registry {
+  readonly protocol: "pi-subagents.session-owner";
+  readonly version: 1;
+  get(owner: object): SubagentsService | undefined;
+  set(owner: object, service: SubagentsService): void;
+  deleteIf(owner: object, service: SubagentsService): void;
+}
+const host = globalThis as typeof globalThis & { [key]?: unknown };
+const services: Registry | undefined = (() => {
+  try {
+    if (key in host) {
+      const existing = host[key] as Partial<Registry> | null;
+      // Compatibility only, not authentication against hostile extensions.
+      return existing !== null && typeof existing === "object" &&
+        existing.protocol === "pi-subagents.session-owner" && existing.version === 1 &&
+        typeof existing.get === "function" && typeof existing.set === "function" &&
+        typeof existing.deleteIf === "function" ? existing as Registry : undefined;
+    }
+    const entries = new WeakMap<object, SubagentsService>();
+    const registry: Registry = Object.freeze({
+      protocol: "pi-subagents.session-owner",
+      version: 1,
+      get: (owner: object) => entries.get(owner),
+      set: (owner: object, service: SubagentsService) => { entries.set(owner, service); },
+      deleteIf: (owner: object, service: SubagentsService) => {
+        if (entries.get(owner) === service) entries.delete(owner);
+      },
+    });
+    host[key] = registry;
+    return registry;
+  } catch {
+    // An inaccessible/unsupported slot must not break the native global runner.
+    return undefined;
+  }
+})();
+
+/** Exact SDK SessionManager identity only; no global or session-id fallback. */
+export function getSubagentsServiceForSession(owner: object): SubagentsService | undefined {
+  return services?.get(owner);
+}
+
+// Internal factory capability. Not exported from the package's public root.
+export function createSessionServiceBinding(service: SubagentsService) {
+  let owner: object | undefined;
+  let disabled = false;
+  const clear = () => {
+    if (owner) services?.deleteIf(owner, service);
+  };
+  return {
+    isCurrent() {
+      if (owner && services?.get(owner) !== service) {
+        clear();
+        disabled = true;
+      }
+      return !disabled && owner !== undefined && services?.get(owner) === service;
+    },
+    start(next: object) {
+      if (disabled) return;
+      if (owner && (owner !== next || services?.get(owner) !== service)) {
+        // A manager's queue must never migrate or replay a replaced factory.
+        clear();
+        disabled = true;
+        return;
+      }
+      owner = next;
+      services?.set(owner, service);
+    },
+    shutdown() {
+      clear();
+      disabled = true;
+    },
+  };
+}
