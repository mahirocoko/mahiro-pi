new file mode 100644
index 0000000000000000000000000000000000000000..8cb99f6c1d2cf05b7e8d89196cf4e7b2487304ff
--- /dev/null
+++ b/src/service/child-controls.ts
@@ -0,0 +1,83 @@
+import type { AgentSession, ExtensionAPI, ToolDefinition, ToolInfo } from "@earendil-works/pi-coding-agent";
+
+/** Factory-private registrations, not grants or an in-process sandbox. */
+export function createChildControlOwner(isCurrent: () => boolean) {
+  type Record = {
+    session?: AgentSession;
+    manager?: object;
+    active: boolean;
+    revoked: boolean;
+    definitions: Map<string, { definition: ToolDefinition; execute: ToolDefinition["execute"] }>;
+  };
+  const records = new WeakMap<object, Record>();
+  const pending = new Set<Record>();
+  const revoke = (record: Record) => {
+    record.active = false;
+    record.revoked = true;
+    if (record.manager && records.get(record.manager) === record) records.delete(record.manager);
+    pending.delete(record);
+  };
+  return {
+    owns(manager: object, tool: ToolInfo | undefined): boolean {
+      try {
+        if (!isCurrent() || !tool || !["ask_parent", "notify_parent"].includes(tool.name)) return false;
+        const record = records.get(manager);
+        if (!record?.active || record.revoked || !record.session || record.manager !== manager) return false;
+        const captured = record.definitions.get(tool.name);
+        if (!captured || record.session.getToolDefinition(tool.name) !== captured.definition ||
+          captured.definition.execute !== captured.execute) return false;
+        // ToolInfo has no execute. Compare the fresh host entry's identity-bearing
+        // schema/source references, then prove its definition via the public SDK.
+        const actual = record.session.getAllTools().find((entry) => entry.name === tool.name);
+        return actual !== undefined && actual.parameters === tool.parameters &&
+          actual.sourceInfo === tool.sourceInfo && tool.parameters === captured.definition.parameters;
+      } catch {
+        return false;
+      }
+    },
+    prepare(definitions: readonly ToolDefinition[]) {
+      const record: Record = {
+        active: false,
+        revoked: false,
+        definitions: new Map(definitions.filter((tool) => ["ask_parent", "notify_parent"].includes(tool.name))
+          .map((definition) => [definition.name, { definition, execute: definition.execute }])),
+      };
+      return {
+        extension(pi: ExtensionAPI) {
+          pi.on("session_start", (_event, ctx) => {
+            if (record.revoked || (record.manager && record.manager !== ctx.sessionManager)) {
+              revoke(record);
+              return;
+            }
+            record.manager = ctx.sessionManager;
+          });
+          pi.on("session_shutdown", () => revoke(record));
+        },
+        bind(session: AgentSession) {
+          if (record.revoked || record.session) { revoke(record); return; }
+          record.session = session;
+          pending.add(record);
+        },
+        activate() {
+          const session = record.session;
+          if (record.revoked || !isCurrent() || !session || !record.manager ||
+            record.definitions.size === 0 || [...record.definitions.values()].some(({ definition, execute }) =>
+              session.getToolDefinition(definition.name) !== definition || definition.execute !== execute)) {
+            revoke(record);
+            return;
+          }
+          const previous = records.get(record.manager);
+          if (previous && previous !== record) revoke(previous);
+          records.set(record.manager, record);
+          record.active = true;
+        },
+        revoke: () => revoke(record),
+      };
+    },
+    clear() {
+      for (const record of pending) revoke(record);
+    },
+  };
+}
+
+export type ChildControlOwner = ReturnType<typeof createChildControlOwner>;
